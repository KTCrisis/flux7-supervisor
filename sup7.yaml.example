mesh:
  url: http://localhost:9090
  agent_id: supervisor

memory:
  url: http://localhost:9070
  enabled: true
  store_decisions: true
  recall_on_start: true
  recall_limit: 20
  tags: [supervisor, decision]

evaluator:
  provider: ollama           # ollama | anthropic | claude-code | jev
  model: qwen3:14b           # or claude-sonnet-4-6 (ignored for claude-code)
  url: http://localhost:11434 # Ollama URL (ignored for anthropic/claude-code)
  timeout: 30
  callback_timeout: 120      # seconds to wait for Claude Code MCP response
  confidence_threshold: 0.8
  # chain:                     # optional: providers tried in order, next on failure (see README)
  #   - provider: jev
  #     jev: { backend: cloudflare, api_key_env: CLOUDFLARE_WORKERS_AI_TOKEN }
  #   - provider: ollama
  #     model: qwen3:14b
  # jev:                       # only for provider: jev (see README)
  #   backend: cloudflare      # cloudflare | typesafe
  #   api_key_env: CLOUDFLARE_API_TOKEN
  #   account_id_env: CLOUDFLARE_ACCOUNT_ID
  #   redact_params: [content]

admin:
  enabled: false             # HTTP admin API for flux7-console (see README)
  port: 9096
  token: ""

mcp_server:
  enabled: true              # sup7_pending + sup7_verdict via MCP (not started yet, see README)
  transport: stdio           # stdio (registered in mesh7 config) or http
  port: 9095                 # only for http transport

poll:
  interval: 2s
  tool_scopes: []            # glob filters, empty = all

rules:
  - name: safe-reads
    # exact names: "tool contains read" would also approve gmail_mark_as_read, which writes
    condition: "tool in filesystem.read_file, filesystem.read_text_file, filesystem.read_multiple_files, filesystem.read_media_file, filesystem.list_directory, filesystem.list_directory_with_sizes, filesystem.directory_tree, filesystem.search_files, filesystem.get_file_info"
    action: approve
    confidence: 0.95
  - name: project-writes
    condition: "params.path starts_with project_dir"
    action: approve
    confidence: 0.9
  - name: injection-risk
    condition: "injection_risk == true"
    action: escalate
    confidence: 1.0

project_dirs:
  - /home/fluxart/flux7-mesh
  - /home/fluxart/flux7-console

decision_log: sup7-decisions.jsonl
